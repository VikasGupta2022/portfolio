# ==========================================
# Vikas Gupta Portfolio - Backend Environment
# ==========================================

# Application Settings
APP_NAME="Vikas Gupta Portfolio API"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# MySQL Database Configuration
# Default XAMPP settings: user='root', password='', port=3306
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vikas_portfolio_db

# Fallback to local SQLite if MySQL service is not currently running
ENABLE_SQLITE_FALLBACK=true

# Notification Contact Email
RECEIVER_EMAIL=vikasgupta2020vg@gmail.com
